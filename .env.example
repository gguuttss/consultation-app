# Radix Network Configuration
RADIX_NETWORK=stokenet
RADIX_GATEWAY_URL=https://stokenet.radixdlt.com
GOVERNANCE_COMPONENT_ADDRESS=component_tdx_2_1...
DAPP_DEFINITION_ADDRESS=account_tdx_2_1...
ADMIN_BADGE_ADDRESS=resource_tdx_2_1...

# Client-side env vars (must be prefixed with VITE_)
VITE_RADIX_NETWORK=stokenet
VITE_DAPP_DEFINITION_ADDRESS=account_tdx_2_1...
VITE_ADMIN_BADGE_ADDRESS=resource_tdx_2_1...
VITE_GOVERNANCE_COMPONENT_ADDRESS=component_tdx_2_1...

# Database (provisioned by pnpm ship or add your own)
# DATABASE_URL=postgresql://...
